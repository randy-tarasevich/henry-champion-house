---
import Layout from "../layouts/Layout.astro";

// Community partners who've helped with the restoration. Confirmed list
// from Charles, 2026-08-28.
const partners = [
  {
    name: "Gray House Farms",
    description:
      "Local support during the early days of the restoration.",
    url: "https://www.facebook.com/GrayHouseFarms/",
  },
  {
    name: "Interesting Landscapes LLC",
    description:
      "Tree removal, clearing the park area facing the house, and grounds landscaping when the Trust acquired the property.",
    url: "https://www.facebook.com/InterestingLandscapes/",
  },
  {
    name: "Shagbark Lumber",
    description:
      "Lumber and building materials supplier for the restoration.",
    url: "https://shagbarklumber.com/",
  },
];
---

<Layout
  title="Community & Partners"
  description="With thanks to the local businesses and vendors who've supported the restoration of the General Henry Champion House."
>
  <!-- Hero -->
  <section class="mx-auto max-w-3xl px-6 pt-20 pb-10 text-center">
    <h1 class="text-4xl md:text-5xl">Thank You</h1>
    <p class="mx-auto mt-4 max-w-xl text-lg text-[var(--color-charcoal)]">
      This restoration hasn't been the Trust's work alone.
    </p>
  </section>

  <article class="mx-auto max-w-3xl px-6 pb-16">
    <!-- Intro -->
    <section>
      <p class="leading-relaxed text-[var(--color-charcoal)]">
        Bringing a 1790 landmark back takes more than funding &mdash; it takes people willing to show up
        and do the work. We're grateful to the local businesses, tradespeople, and vendors who've
        contributed their time, materials, and expertise along the way.
      </p>
    </section>

    <!-- Featured partners -->
    <section class="mt-14">
      <h2 class="text-2xl">Our Partners</h2>
      <div class="mt-6 space-y-4">
        {partners.map((partner) => (
          <div class="rounded-lg border border-[var(--color-stone)] bg-[var(--color-parchment)] px-6 py-6">
            <h3 class="text-lg">{partner.name}</h3>
            <p class="mt-2 text-sm leading-relaxed text-[var(--color-charcoal)]">{partner.description}</p>
            {partner.url && (
              <a href={partner.url} target="_blank" rel="noopener noreferrer" class="mt-3 inline-block text-sm text-[var(--color-brick)] hover:underline">
                Visit their page &rarr;
              </a>
            )}
          </div>
        ))}
      </div>
    </section>

    <!-- General thanks -->
    <section class="mt-14">
      <p class="leading-relaxed text-[var(--color-charcoal)]">
        With thanks as well to the many additional local businesses and suppliers who've supported this
        project along the way. If you've contributed to the restoration and would like to be listed here,
        <a href="/visit" class="text-[var(--color-brick)] hover:underline">get in touch</a>.
      </p>
    </section>

    <!-- CTA -->
    <section class="mt-16 rounded-lg border border-[var(--color-stone)] bg-[var(--color-parchment)] px-8 py-10 text-center">
      <h2 class="text-2xl">Want to Help?</h2>
      <p class="mx-auto mt-4 max-w-xl leading-relaxed text-[var(--color-charcoal)]">
        Whether it's a gift, materials, or expertise, every bit of support moves this restoration forward.
      </p>
      <a href="/donate" class="btn-primary mt-6 shadow-lg shadow-black/50 ring-1 ring-white/15">Support the Restoration</a>
    </section>
  </article>
</Layout>
