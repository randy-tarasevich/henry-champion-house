---
import Layout from "../layouts/Layout.astro";

const wasSent = Astro.url.searchParams.get("sent") === "1";
---

<Layout
  title="Visit / Contact"
  description="Get in touch with the General Henry Champion Trust. The house is currently under restoration and not open for public visits."
>
  <!-- Hero -->
  <section class="relative">
    <img
      src="/images/home-front-spring.jpg"
      alt="Front elevation of the General Henry Champion House with the driveway leading up to it"
      class="h-[40vh] w-full object-cover"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/45 to-black/5"></div>
    <div class="absolute inset-0 flex items-end">
      <div class="mx-auto w-full max-w-6xl px-6 pb-12 text-white [text-shadow:0_2px_10px_rgba(0,0,0,0.55)]">
        <h1 class="text-4xl md:text-5xl">Visit / Contact</h1>
        <p class="eyebrow mt-3 text-white/90">Colchester, Connecticut</p>
        <p class="mt-4 max-w-xl text-lg text-white/90">
          The house is privately owned and under active restoration &mdash; here's how to reach us.
        </p>
      </div>
    </div>
  </section>

  <div class="mx-auto grid max-w-5xl gap-14 px-6 py-16 md:grid-cols-2">
    <div>
      <section>
        <h2 class="text-2xl">The Property</h2>
        <p class="mt-4 leading-relaxed text-[var(--color-charcoal)]">
          General Henry Champion House<br />
          526 Westchester Rd, Colchester, CT 06415
        </p>
      </section>

      <section class="mt-10">
        <h2 class="text-2xl">A Work in Progress</h2>
        <p class="mt-4 leading-relaxed text-[var(--color-charcoal)]">
          The house is currently undergoing restoration and is not open for public visits or tours at this
          time. As work progresses, we hope to welcome visitors &mdash; check back here, or reach out
          below, for updates.
        </p>
      </section>

      <section class="mt-10 text-sm text-[var(--color-charcoal)]">
        <p class="eyebrow mb-2">Direct Contact</p>
        <p><a href="mailto:charlespjordan@icloud.com" class="hover:text-[var(--color-brick)]">charlespjordan@icloud.com</a></p>
        <p><a href="tel:+19174602260" class="hover:text-[var(--color-brick)]">(917) 460-2260</a></p>
      </section>
    </div>

    <div>
      <h2 class="text-2xl">Get in Touch</h2>
      <p class="mt-4 leading-relaxed text-[var(--color-charcoal)]">
        Have a question, a document, or an old photograph of the house? We'd love to hear from you.
      </p>

      {wasSent && (
        <p class="mt-6 border border-[var(--color-brick)] bg-white px-4 py-3 text-sm text-[var(--color-brick)]">
          Thank you &mdash; your message has been sent.
        </p>
      )}

      <form method="POST" action="/api/contact" class="mt-6 space-y-5">
        <div>
          <label for="name" class="block text-sm text-[var(--color-charcoal)]">Name</label>
          <input
            type="text"
            id="name"
            name="name"
            required
            class="mt-1 w-full rounded-lg border border-[var(--color-stone)] bg-white px-3 py-2 text-sm focus:border-[var(--color-brick)] focus:outline-none"
          />
        </div>
        <div>
          <label for="email" class="block text-sm text-[var(--color-charcoal)]">Email</label>
          <input
            type="email"
            id="email"
            name="email"
            required
            class="mt-1 w-full rounded-lg border border-[var(--color-stone)] bg-white px-3 py-2 text-sm focus:border-[var(--color-brick)] focus:outline-none"
          />
        </div>
        <div>
          <label for="message" class="block text-sm text-[var(--color-charcoal)]">Message</label>
          <textarea
            id="message"
            name="message"
            rows="5"
            required
            class="mt-1 w-full rounded-lg border border-[var(--color-stone)] bg-white px-3 py-2 text-sm focus:border-[var(--color-brick)] focus:outline-none"
          ></textarea>
        </div>
        <button type="submit" class="btn-primary">Send Message</button>
      </form>
    </div>
  </div>
</Layout>
