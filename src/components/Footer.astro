---
import { navLinks } from "../data/navLinks";

const footerLinks = [...navLinks, { href: "/donate", label: "Donate" }];
const year = new Date().getFullYear();
---

<footer class="border-t border-[var(--color-stone)] bg-[var(--color-parchment)]">
  <div class="mx-auto grid max-w-6xl gap-8 px-6 py-12 md:grid-cols-4">
    <div>
      <p class="text-lg">The General Henry Champion House</p>
      <p class="mt-2 text-sm text-[var(--color-charcoal)]">
        526 Westchester Rd<br />
        Colchester, CT 06415
      </p>
    </div>

    <div class="text-sm text-[var(--color-charcoal)]">
      <p class="mb-2 text-xs eyebrow text-[var(--color-brick)]">Pages</p>
      {footerLinks.map((link) => (
        <p><a href={link.href} class="hover:text-[var(--color-brick)]">{link.label}</a></p>
      ))}
    </div>

    <div class="text-sm text-[var(--color-charcoal)]">
      <p class="mb-2 text-xs eyebrow text-[var(--color-brick)]">Contact</p>
      <p><a href="mailto:info@henrychampionhouse.org" class="hover:text-[var(--color-brick)]">info@henrychampionhouse.org</a></p>
      <p><a href="tel:+18606030603" class="hover:text-[var(--color-brick)]">(860) 603-0603</a></p>
    </div>

    <div class="text-sm text-[var(--color-charcoal)]">
      <p class="mb-2 text-xs eyebrow text-[var(--color-brick)]">The Trust</p>
      <p>General Henry Champion Trust, Inc.</p>
      <p>A 501(c)(3) nonprofit organization</p>
      <p>EIN: 41-5346804</p>
    </div>
  </div>

  <div class="border-t border-[var(--color-stone)] px-6 py-4 text-center text-xs text-[var(--color-charcoal)]">
    &copy; {year} General Henry Champion Trust, Inc. All rights reserved.
  </div>
</footer>
