---
const navLinks = [
  { href: "/", label: "Home" },
  { href: "/history", label: "History" },
  { href: "/restoration", label: "Restoration Progress" },
  { href: "/visit", label: "Visit / Contact" },
];
const currentPath = Astro.url.pathname;
---

<header class="border-b border-[var(--color-stone)] bg-[var(--color-cream)]">
  <div class="mx-auto flex max-w-6xl items-center justify-between px-6 py-5">
    <a href="/" class="text-lg tracking-wide text-[var(--color-ink)]">
      <span class="block text-xl">The General Henry Champion House</span>
      <span class="mt-1 block text-sm eyebrow">Colchester, Connecticut &middot; Est. 1790</span>
    </a>

    <nav class="hidden items-center gap-6 md:flex">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class:list={[
            "text-sm tracking-wide hover:text-[var(--color-brick)]",
            currentPath === link.href ? "text-[var(--color-brick)]" : "text-[var(--color-charcoal)]",
          ]}
        >
          {link.label}
        </a>
      ))}
    </nav>

    <a href="/donate" class="btn-primary text-sm">Donate</a>
  </div>

  <nav class="flex flex-wrap gap-4 border-t border-[var(--color-stone)] px-6 py-2 text-xs md:hidden">
    {navLinks.map((link) => (
      <a
        href={link.href}
        class:list={[
          "tracking-wide",
          currentPath === link.href ? "text-[var(--color-brick)]" : "text-[var(--color-charcoal)]",
        ]}
      >
        {link.label}
      </a>
    ))}
  </nav>
</header>
